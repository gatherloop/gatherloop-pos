# Staff credentials used only to seed/clean up test data (category, product,
# variant, table) directly against the API before each spec runs — the
# customer app itself is anonymous and never sees these (D3/D8 in
# docs/prd-table-ordering.md). Defaults match apps/order-e2e's .env.example.
E2E_USERNAME=
E2E_PASSWORD=

# Base URL of the Go API the seeded test data talks to, and the destination
# Next's rewrite() proxies /api/:path* to (D13 in
# docs/trd-order-app-nextjs-migration.md) — see NEXT_PUBLIC_API_BASE_URL in
# apps/order-next/.env.example.
API_BASE_URL=http://127.0.0.1:8080

# Base URL of the customer Next.js app under test, served by `next start`
# (a real server, unlike apps/order-e2e's `vite preview` — no base path).
BASE_URL=http://localhost:3000/
