DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=
PORT=
JWT_SECRET=

# Logging
LOG_LEVEL=info         # debug | info | warn | error  (default: info)
APP_ENV=development    # environment name attached to every log line (default: development)
SERVICE_NAME=gatherloop-pos-api  # service name attached to every log line

# CORS
# Comma-separated list of origins allowed to make cross-origin requests
# (with credentials). Example: the POS web app in dev, plus the customer
# order app's Vite dev server (4200) and `vite preview` (4300, what
# apps/order-e2e runs against — see apps/order/vite.config.ts).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:4300

# DOKU QRIS payment gateway (docs/prd-order-checkout-qris-doku.md, D21).
# Sandbox is what CI, local dev and phases 3-12 run against; production
# credentials exist only in the API host's systemd EnvironmentFile.
# NEVER add any of these to apps/order-web or any Vercel project.
#
# The credentials below come from the DOKU Back Office SNAP integration page,
# and they are per-environment: a sandbox credential set sent to
# https://api.doku.com (or the reverse) is rejected with
# "Unauthorized. Unknown Client", as is a Checkout/Jokul client id used here
# instead of the SNAP one, or a SNAP client whose public key (the pair of
# DOKU_PRIVATE_KEY below) has not been uploaded to the Back Office.
#
# `go run ./cmd/dokucheck` verifies these credentials against DOKU, and
# `go run ./cmd/dokucheck generate` also sends a real qr-mpm-generate and
# prints DOKU's responseCode and responseMessage for it.
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_CLIENT_ID=                # SNAP client id, sent as X-CLIENT-KEY / X-PARTNER-ID
DOKU_CLIENT_SECRET=
DOKU_PRIVATE_KEY=              # PEM, newline-escaped (e.g. \n between lines)
DOKU_MERCHANT_ID=
DOKU_CHANNEL_ID=
DOKU_TERMINAL_ID=              # terminalId on every qr-mpm-generate; alphanumeric, 3-16 chars
DOKU_MERCHANT_POSTAL_CODE=     # additionalInfo.postalCode (optional; e.g. 12190)
DOKU_QRIS_FEE_TYPE=            # additionalInfo.feeType (optional; leave empty to use the Back Office default)
DOKU_QRIS_EXPIRY_SECONDS=300   # QR validity window in seconds, sent as validityPeriod (default: 300)
CASH_PAYMENT_EXPIRY_SECONDS=600 # walk-and-queue window for an order-app cash payment (docs/prd-order-cash-payment.md D5)
ORDER_PAYMENT_WALLET_ID=       # the QRIS wallet's id; validated by checkout from phase 6
ORDER_WEB_BASE_URL=            # apps/order-web's public origin, no trailing slash (docs/prd-order-whatsapp-notifications.md D11); empty disables the WhatsApp gateway

# Expo push notifications for the KDS app (docs/prd-kds-order-notifications.md D7).
# The API is the only thing that ever calls Expo — no frontend holds this token.
EXPO_PUSH_ACCESS_TOKEN=        # Expo access token, sent as "Authorization: Bearer ..." to exp.host
KDS_PUSH_SOUND=order_alert.wav # .wav filename with no directory, matching apps/kds-mobile's bundled sound, or "default" (D23)
KDS_DISPATCH_INTERVAL_SECONDS=15  # sweeper tick that catches a crash, a deploy or a push outage; drives both the KDS and guest notification outboxes (D5, default: 15)

# Fonnte WhatsApp gateway for guest order-ready notifications
# (docs/prd-order-whatsapp-notifications.md D1, D10). The token authenticates a single linked
# WhatsApp device; leaving it empty boots the API with a disabled gateway that records every
# guest notification as skipped rather than failing checkout or the dispatcher (D10).
# `go run ./cmd/fonntecheck -to 0812...` sends one real test message and prints Fonnte's outcome.
FONNTE_TOKEN=
FONNTE_BASE_URL=https://api.fonnte.com
