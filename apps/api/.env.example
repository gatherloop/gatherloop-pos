DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=
PORT=
JWT_SECRET=

# Logging
LOG_LEVEL=info         # debug | info | warn | error  (default: info)
APP_ENV=development    # environment name attached to every log line (default: development)
SERVICE_NAME=gatherloop-pos-api  # service name attached to every log line

# CORS
# Comma-separated list of origins allowed to make cross-origin requests
# (with credentials). Example: the POS web app in dev, plus the customer
# order app's Vite dev server (4200) and `vite preview` (4300, what
# apps/order-e2e runs against — see apps/order/vite.config.ts).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:4300

# DOKU QRIS payment gateway (docs/prd-order-checkout-qris-doku.md, D21).
# Sandbox is what CI, local dev and phases 3-12 run against; production
# credentials exist only in the API host's systemd EnvironmentFile.
# NEVER add any of these to apps/order-web or any Vercel project.
DOKU_BASE_URL=https://api-sandbox.doku.com
DOKU_CLIENT_ID=
DOKU_CLIENT_SECRET=
DOKU_PRIVATE_KEY=              # PEM, newline-escaped (e.g. \n between lines)
DOKU_MERCHANT_ID=
DOKU_CHANNEL_ID=
DOKU_QRIS_EXPIRY_SECONDS=300   # QR validity window in seconds (default: 300)
ORDER_PAYMENT_WALLET_ID=       # the QRIS wallet's id; validated by checkout from phase 6