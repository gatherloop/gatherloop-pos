DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_HOST=
DB_PORT=
PORT=
JWT_SECRET=

# Logging
LOG_LEVEL=info         # debug | info | warn | error  (default: info)
APP_ENV=development    # environment name attached to every log line (default: development)
SERVICE_NAME=gatherloop-pos-api  # service name attached to every log line

# CORS
# Comma-separated list of origins allowed to make cross-origin requests
# (with credentials). Example: the POS web app in dev, plus the customer
# order app's Vite dev server (4200) and `vite preview` (4300, what
# apps/order-e2e runs against — see apps/order/vite.config.ts).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:4300