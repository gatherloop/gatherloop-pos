# Base URL of the API this SPA calls directly (no server-side proxy — D18/D22
# in docs/prd-table-ordering.md). Baked into the static bundle at build time,
# so a change requires a rebuild, not just a restart. See apps/api/docs/DEPLOY_NATIVE.md.
VITE_API_BASE_URL=

# Gates the QRIS checkout stub screen (FR-8/D10 in
# docs/prd-table-ordering.md). Defaults to false when unset or anything
# other than "true" — the cart's Checkout button still navigates to the
# route, but it shows a "not available" message instead of the QRIS copy.
VITE_ORDER_CHECKOUT_ENABLED=
