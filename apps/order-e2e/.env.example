# Staff credentials used only to seed/clean up test data (category, product,
# variant, table) directly against the API before each spec runs — the
# customer app itself is anonymous and never sees these (D3/D8 in
# docs/prd-table-ordering.md). Defaults match apps/web-e2e's global-setup.
E2E_USERNAME=
E2E_PASSWORD=

# Base URL of the Go API the seeded test data and the customer SPA both talk
# to. The SPA calls it directly, cross-origin, with no proxy (D18/D22) — see
# VITE_API_BASE_URL in apps/order/.env.example.
API_BASE_URL=http://127.0.0.1:8080

# Base URL of the customer SPA under test, served by `vite preview` (built
# with base: '/gatherloop-pos/order/' — see apps/order/vite.config.ts). Must
# end with a trailing slash so relative `page.goto()` calls resolve under it.
BASE_URL=http://localhost:4300/gatherloop-pos/order/
