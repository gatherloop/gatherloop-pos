# Base URL of the API the Next.js rewrite proxies /api/:path* to. Post-cutover this is the
# VPS-hosted API's public hostname (behind the reverse proxy), not the old Render URL — see
# apps/api/docs/DEPLOY_NATIVE.md.
NEXT_PUBLIC_API_BASE_URL=

# Origin of the customer order app (apps/order-next), encoded into every
# table's printed QR code (D3/D6 in docs/trd-order-app-nextjs-migration.md).
# No trailing slash. Post-cutover this is the order app's Vercel host, not
# the old https://gatherloop.github.io/gatherloop-pos/order URL.
NEXT_PUBLIC_ORDER_APP_BASE_URL=