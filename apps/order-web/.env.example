# Base URL of the API the Next.js rewrite proxies /api/:path* to (D13 in
# docs/trd-order-app-nextjs-migration.md). Post-cutover this is the
# VPS-hosted API's public hostname (behind the reverse proxy) — see
# apps/api/docs/DEPLOY_NATIVE.md.
NEXT_PUBLIC_API_BASE_URL=

# Same-origin path the browser calls; Next rewrites it to
# NEXT_PUBLIC_API_BASE_URL server-side.
NEXT_PUBLIC_API_PROXY_BASE_URL=/api

# Base URL `getServerSideProps` calls directly, server-side only (D2 in
# docs/trd-order-app-composition-and-ssr.md). `/api` (NEXT_PUBLIC_API_PROXY_BASE_URL)
# does not resolve in Node, so the server needs the API's real origin, not
# the same-origin proxy path. Falls back to NEXT_PUBLIC_API_BASE_URL when
# unset, so this only needs setting where the two differ (e.g. an internal
# hostname the server can reach that the browser cannot).
API_INTERNAL_BASE_URL=

# Gates the QRIS checkout stub screen. Defaults to false when unset or
# anything other than "true" — the cart's Checkout button still navigates to
# the route, but it shows a "not available" message instead of the QRIS
# copy.
NEXT_PUBLIC_ORDER_CHECKOUT_ENABLED=
