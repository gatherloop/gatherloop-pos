{
  "extends": ["plugin:@nx/react", "../../.eslintrc.json"],
  "ignorePatterns": ["!**/*"],
  "overrides": [
    {
      "files": ["*.ts", "*.tsx", "*.js", "*.jsx"],
      "rules": {}
    },
    {
      "files": ["*.ts", "*.tsx"],
      "rules": {}
    },
    {
      "files": ["*.js", "*.jsx"],
      "rules": {}
    },
    {
      "files": ["src/presentation/controllers/**/*.ts", "src/presentation/controllers/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react-hook-form",
                "message": "useForm belongs to the component that renders the fields, not the controller. See docs/trd-form-ownership-refactor.md and docs/forms.md."
              },
              {
                "name": "@hookform/resolvers/zod",
                "message": "Form resolvers belong next to the form view, not the controller. See docs/trd-form-ownership-refactor.md and docs/forms.md."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/pos/**", "src/presentation/screens/pos/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/app/order/**", "**/screens/order/**", "../order/**"],
                "message": "POS must not import the order app's screens or composition roots."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/app/order/**", "src/presentation/screens/order/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/app/pos/**", "**/screens/pos/**", "../pos/**"],
                "message": "Order must not import the POS app's screens or composition roots."
              }
            ]
          }
        ]
      }
    }
  ]
}
